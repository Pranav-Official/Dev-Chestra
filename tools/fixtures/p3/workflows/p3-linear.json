{
  "schemaVersion": 1,
  "id": "p3-linear",
  "name": "P3 acceptance linear workflow",
  "description": "start -> agent -> shell -> end; fake provider only",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "name": "Inputs",
        "params": [
          { "name": "topic", "type": "string", "required": true }
        ],
        "ui": { "x": 40, "y": 180 }
      },
      {
        "id": "research",
        "type": "agent",
        "name": "Research",
        "cli": "fake",
        "prompt": "Summarize {{ start.topic }} with three points.",
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "points"],
          "properties": {
            "summary": { "type": "string", "maxLength": 2000 },
            "points": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "permissions": { "network": false, "write": ["workspace"] },
        "workspace": { "mode": "scratch" },
        "limits": { "timeoutMin": 5, "validationRetries": 1, "crashRetries": 0 },
        "context": { "project": "none", "workflow": "none" },
        "ui": { "x": 300, "y": 180 }
      },
      {
        "id": "render",
        "type": "shell",
        "name": "Render",
        "command": "printf '%s\\n' {{ research.summary }}",
        "workspace": { "mode": "scratch" },
        "timeoutMin": 1,
        "allowFailure": false,
        "ui": { "x": 560, "y": 180 }
      },
      {
        "id": "done",
        "type": "end",
        "name": "Done",
        "status": "success",
        "result": "{ \"summary\": research.summary, \"points\": research.points }",
        "ui": { "x": 820, "y": 180 }
      }
    ],
    "edges": [
      { "id": "e-start-research", "from": "start", "to": "research" },
      { "id": "e-research-render", "from": "research", "to": "render" },
      { "id": "e-render-done", "from": "render", "to": "done" }
    ]
  }
}
