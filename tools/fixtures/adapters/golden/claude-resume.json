{
  "label": "SYNTHETIC golden argv expectation, not a live capture",
  "cli": "claude-code",
  "version": "2.1.310",
  "case": "resume-writable-network",
  "bin": "claude",
  "args": [
    "-p",
    "--output-format",
    "stream-json",
    "--verbose",
    "--resume",
    "11111111-1111-4111-8111-111111111111",
    "--mcp-config",
    "/run/mcp.json",
    "--strict-mcp-config",
    "--permission-mode",
    "dontAsk",
    "--allowedTools",
    "mcp__relay__*,Read,Glob,Grep,Edit,Write,Bash,WebFetch,WebSearch",
    "--max-turns",
    "4"
  ]
}
