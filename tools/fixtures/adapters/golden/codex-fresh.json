{
  "label": "SYNTHETIC golden argv expectation, not a live capture",
  "cli": "codex",
  "version": "0.164.0",
  "case": "fresh-workspace-write-network",
  "bin": "codex",
  "args": [
    "exec",
    "--json",
    "--sandbox",
    "workspace-write",
    "--cd",
    "/work",
    "--skip-git-repo-check",
    "-m",
    "gpt-5",
    "-c",
    "sandbox_workspace_write.network_access=true",
    "-c",
