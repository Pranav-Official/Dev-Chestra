{
  "schemaVersion": 1,
  "id": "sibling-scope",
  "name": "sibling isolation",
  "description": "A node sees only true ancestors, never siblings",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "name": "Inputs",
        "params": [
          {
            "name": "route",
            "type": "string",
            "required": true,
            "default": "a"
          }
        ],
        "ui": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "agent_left",
        "type": "agent",
        "name": "Agent Left",
        "cli": "fake",
        "prompt": "Run Agent Left for {{ start.route }}.",
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "note"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "maxLength": 100
            },
            "note": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "permissions": {
          "network": false,
          "write": [
            "workspace"
          ]
        },
        "workspace": {
          "mode": "scratch"
        },
        "limits": {
          "timeoutMin": 2,
          "validationRetries": 1,
          "crashRetries": 0
        },
        "context": {
          "project": "none",
          "workflow": "none"
        },
        "ui": {
          "x": 380,
          "y": -80
        }
      },
      {
        "id": "agent_right",
        "type": "agent",
        "name": "Agent Right",
        "cli": "fake",
        "prompt": "Run Agent Right for {{ start.route }}.",
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "note"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "maxLength": 100
            },
            "note": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "permissions": {
          "network": false,
          "write": [
            "workspace"
          ]
        },
        "workspace": {
          "mode": "scratch"
        },
        "limits": {
          "timeoutMin": 2,
          "validationRetries": 1,
          "crashRetries": 0
        },
        "context": {
          "project": "none",
          "workflow": "none"
        },
        "ui": {
          "x": 380,
          "y": 80
        }
      },
      {
        "id": "merge",
        "type": "join",
        "name": "Merge",
        "mode": "all",
        "inputs": [
          "left",
          "right"
        ],
        "ui": {
          "x": 620,
          "y": 0
        }
      },
      {
        "id": "done",
        "type": "end",
        "name": "done",
        "status": "success",
        "result": "merge",
        "ui": {
          "x": 820,
          "y": 0
        }
      }
    ],
    "edges": [
      {
        "id": "e-start-left",
        "from": "start",
        "to": "agent_left"
      },
      {
        "id": "e-start-right",
        "from": "start",
        "to": "agent_right"
      },
      {
        "id": "e-left-join",
        "from": "agent_left",
        "to": "merge.left"
      },
      {
        "id": "e-right-join",
        "from": "agent_right",
        "to": "merge.right"
      },
      {
        "id": "e-join-end",
        "from": "merge",
        "to": "done"
      }
    ]
  }
}
