# Relay decision providers.
#
# Copy this file to `.env` in the directory you run `relay` from (the repo root
# for `pnpm relay:start`), fill in the values you need, and never commit `.env`
# (it is gitignored). Real shell exports take priority over `.env`.
#
# Relay reads only the three names below from `.env`, keeps them in memory for
# decision calls only, and never passes them to agent CLIs or shell nodes.
# You only need the provider(s) your decision nodes use.

# --- Jev (TypeSafe AI): decision provider "typesafe-jev" ---
# API key from the TypeSafe AI console.
TYPESAFE_API_KEY=

# --- Clef / Clef-flash (Cloudflare Workers AI): providers "cloudflare-clef" and
# "cloudflare-clef-flash" ---
# Your Cloudflare account id (dashboard sidebar, or the account overview page).
CLOUDFLARE_ACCOUNT_ID=
# A Cloudflare API token that is allowed to run Workers AI models.
CLOUDFLARE_AUTH_TOKEN=
