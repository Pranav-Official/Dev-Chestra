{
  "name": "relay-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Relay / DevChestra local workflow orchestrator workspace",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm build && pnpm -r --if-present run test",
    "test:root": "vitest run",
    "typecheck": "pnpm -r --if-present run build && pnpm -r --if-present run typecheck",
    "check": "biome check . && pnpm typecheck && pnpm depcruise && node scripts/check-browser.mjs",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages tools apps",
    "audit": "pnpm audit --audit-level high",
    "demo:p0": "pnpm --filter @relay/p0-demo demo",
    "demo:p1": "pnpm --filter @relay/p1-smoke demo",
    "demo:p2": "pnpm --filter @relay/p2-smoke demo",
    "demo:p3": "pnpm --filter @relay/p3-smoke demo",
    "test:p3": "pnpm --filter @relay/p3-smoke test",
    "test:e2e:p3": "pnpm --filter @relay/p3-smoke test:e2e",
    "web:build": "pnpm --filter @relay/web build",
    "web:dev": "pnpm --filter @relay/web dev",
    "relay": "tsx packages/cli/src/main.ts",
    "relay:start": "tsx packages/cli/src/main.ts start",
    "relay:run": "tsx packages/cli/src/main.ts run",
    "relay:resume": "tsx packages/cli/src/main.ts resume",
    "relay:doctor": "tsx packages/cli/src/main.ts doctor",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.6.0",
    "esbuild": "0.27.7",
    "fast-check": "4.10.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
