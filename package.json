{
  "name": "devchestra-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "DevChestra local workflow orchestrator workspace",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && npm run test --workspaces --if-present",
    "test:root": "vitest run",
    "test:windows": "npm run build && npm exec --workspace=@devchestra/cli -- vitest run test/windows-native.test.ts test/server-commands.e2e.test.ts && npm exec --workspace=@devchestra/adapters -- vitest run test/process.test.ts",
    "typecheck": "npm run build --workspaces --if-present && npm run typecheck --workspaces --if-present",
    "check": "biome check . && npm run typecheck && npm run depcruise && node scripts/check-browser.mjs",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages tools apps",
    "audit": "npm audit --audit-level=high",
    "test:workflows": "npm run test --workspace=@devchestra/e2e-workflows",
    "test:e2e:workflows": "npm run test:e2e --workspace=@devchestra/e2e-workflows",
    "web:build": "npm run build --workspace=@devchestra/web",
    "web:dev": "npm run dev --workspace=@devchestra/web",
    "devchestra": "tsx packages/cli/src/main.ts",
    "devchestra:start": "tsx packages/cli/src/main.ts start",
    "devchestra:run": "tsx packages/cli/src/main.ts run",
    "devchestra:resume": "tsx packages/cli/src/main.ts resume",
    "devchestra:doctor": "tsx packages/cli/src/main.ts doctor",
    "setup:global": "node scripts/setup-global.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.6.0",
    "esbuild": "0.27.7",
    "fast-check": "4.10.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
