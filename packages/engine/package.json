{
  "name": "@relay/engine",
  "version": "0.1.0",
  "description": "Relay run engine: linear start/agent/shell/end execution, recovery and scoped agent sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@relay/adapters": "workspace:*",
    "@relay/core": "workspace:*",
    "@relay/decisions": "workspace:*",
    "@relay/schema": "workspace:*",
    "@relay/store": "workspace:*",
    "@relay/workspaces": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
