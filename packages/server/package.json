{
  "name": "@devchestra/server",
  "version": "0.1.0",
  "description": "DevChestra composition root: loopback agent gateway and server hardening",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@devchestra/adapters": "*",
    "@devchestra/api": "*",
    "@devchestra/core": "*",
    "@devchestra/decisions": "*",
    "@devchestra/mcp": "*",
    "@devchestra/schema": "*",
    "@devchestra/store": "*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
